# JSON Web Token Secret - Must be at least 32 characters in production
JWT_SECRET=your_jwt_secret_here_min_32_chars

# MongoDB Connection URI - Connection string for the database
MONGO_URI=mongodb://localhost:27017/pharmacy_erp

# CORS Allowed Origins - Comma-separated list of allowed domains for frontend access
ALLOWED_ORIGINS=http://localhost:3000

# Server Port
PORT=3000

# Node Environment (development, production)
NODE_ENV=development
